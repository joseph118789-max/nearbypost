    {
      "parameters": {
        "functionCode": "const APPROVED_DIRECT_DOMAINS = [\n  'thestar.com.my', 'nst.com.my', 'freemalaysiatoday.com', 'bernama.com', 'malaymail.com', 'thesundaily.my',\n];\n\nfunction normalizeDomain(url) {\n  try {\n    let host = url.includes('://') ? new URL(url).host : url;\n    return host.toLowerCase().replace(/^www\\./, '');\n  } catch { return ''; }\n}\n\nfunction isApprovedDomain(item) {\n  const mode = (item.source_mode || 'direct_seed').toLowerCase();\n  const domain = normalizeDomain(item.source_domain || item.url || '');\n  if (!domain) return false;\n  if (mode === 'direct_seed') {\n    return APPROVED_DIRECT_DOMAINS.some(d => domain === d || domain.endsWith('.' + d));\n  }\n  return true;\n}\n\nconst filtered = items.filter(item => {\n  const url = item.json.url || '';\n  const mode = (item.json.source_mode || 'direct_seed').toLowerCase();\n\n  if (!url) { item.json._reject = 'missing_url'; return false; }\n  if (mode === 'direct_seed' && !isApprovedDomain(item.json)) { item.json._reject = 'unapproved_domain'; return false; }\n  item.json._reject = null;\n  return true;\n});\n\nconst passed = filtered.length;\nconst rejected = items.length - passed;\nconsole.log('Article Filter: ' + passed + ' passed, ' + rejected + ' rejected');\nreturn filtered;\n"
      },
