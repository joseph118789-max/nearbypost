{
  "name": "Nearbypost News Ingestion",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://www.thestar.com.my/rss/news",
        "options": {
          "timeout": 30000
        }
      },
      "id": "rss_star",
      "name": "Fetch The Star RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://www.malaymail.com/rss/news",
        "options": {
          "timeout": 30000
        }
      },
      "id": "rss_malaymail",
      "name": "Fetch Malay Mail RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        450,
        450
      ]
    },
    {
      "parameters": {
        "functionCode": "const items = $input.all();\nconst normalized = [];\n\nfor (const item of items) {\n  const data = item.json;\n  normalized.push({\n    json: {\n      title: data.title || 'Untitled',\n      url: data.link || data.url || '',\n      source: 'the_star', source_domain: 'www.thestar.com.my',\n      summary: data.description || null,\n      published_at: data.pubDate ? new Date(data.pubDate).toISOString() : new Date().toISOString(),\n      category: 'others'\n    }\n  });\n}\n\nreturn normalized;"
      },
      "id": "normalize_star",
      "name": "Normalize Star Items",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const items = $input.all();\nconst normalized = [];\n\nfor (const item of items) {\n  const data = item.json;\n  normalized.push({\n    json: {\n      title: data.title || 'Untitled',\n      url: data.link || data.url || '',\n      source: 'malay_mail', source_domain: 'www.malaymail.com',\n      summary: data.description || null,\n      published_at: data.pubDate ? new Date(data.pubDate).toISOString() : new Date().toISOString(),\n      category: 'others'\n    }\n  });\n}\n\nreturn normalized;"
      },
      "id": "normalize_malaymail",
      "name": "Normalize Malay Mail Items",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        650,
        450
      ]
    },
    {
      "parameters": {
        "url": "https://nearbypost.com/api/internal/ingest/news",
        "method": "POST",
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "{{ $json.title }}"
            },
            {
              "name": "url",
              "value": "{{ $json.url }}"
            },
            {
              "name": "source",
              "value": "{{ $json.source }}"
            },
            {
              "name": "summary",
              "value": "{{ $json.summary }}"
            },
            {
              "name": "published_at",
              "value": "{{ $json.published_at }}"
            },
            {
              "name": "category",
              "value": "{{ $json.category }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "retry": {
            "maxRetries": 3,
            "retryWait": 5000
          }
        }
      },
      "id": "webhook_post",
      "name": "Send to Laravel Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Fetch BBC News RSS",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch The Star RSS",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Malay Mail RSS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch BBC News RSS": {
      "main": [
        [
          {
            "node": "Normalize BBC Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch The Star RSS": {
      "main": [
        [
          {
            "node": "Normalize Star Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Malay Mail RSS": {
      "main": [
        [
          {
            "node": "Normalize Malay Mail Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize BBC Items": {
      "main": [
        [
          {
            "node": "Send to Laravel Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Star Items": {
      "main": [
        [
          {
            "node": "Send to Laravel Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Malay Mail Items": {
      "main": [
        [
          {
            "node": "Send to Laravel Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}