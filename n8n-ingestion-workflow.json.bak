    },
    {
      "parameters": {
        "functionCode": "return items.map(item => ({ json: { ...item.json, _source: 'Bernama' } }));"
      },
      "id": "tag-bernama",
      "name": "Tag Bernama",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [540, 940]
    },
    {
      "parameters": {
        "functionCode": "const out = []; for (let i = 0; i < items.length; i++) { const item = items[i]; const src = item.json._source || 'unknown'; const text = ((item.json.title || '') + ' ' + (item.json.summary || '')).toLowerCase(); let category = 'general'; if (/ai|artificial intelligence|chatgpt|machine learning/.test(text)) category = 'technology'; else if (/sport\\b|football|basketball|tennis|badminton/.test(text)) category = 'sports'; else if (/politics|election|government|parliament/.test(text)) category = 'politics'; else if (/business|economy|market|trade/.test(text)) category = 'business'; else if (/science|research/.test(text)) category = 'science'; else if (/health|medical|virus|disease/.test(text)) category = 'health'; else if (/crime|theft|fraud|murder/.test(text)) category = 'crime'; else if (/education|school|university/i.test(text)) category = 'education'; else if (/environment|climate|pollution/i.test(text)) category = 'environment'; else if (/kl |kuala lumpur|petaling jaya|penang|johor/i.test(text)) category = 'malaysia'; out.push({ json: { title: item.json.title || 'Untitled', url: item.json.url || item.json.link || '', source: src, published_at: item.json.pubDate || item.json.datePublished || new Date().toISOString(), summary: (item.json.summary || item.json.description || '').replace(/<[^>]*>/g, '').substring(0, 500), category } }); } return out;"
      },
      "id": "normalize-generic",
      "name": "Normalize RSS Items",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [760, 520]
    },
    {
      "parameters": {
        "functionCode": "const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms)); const locationPatterns = [/\\bin ([A-Z][A-Za-z]+(?:\\s+[A-Z][A-Za-z]+){0,2})\\b/, /\\bfrom ([A-Z][A-Za-z]+(?:\\s+[A-Z][A-Za-z]+){0,2})\\b/, /\\bin ([A-Z][A-Za-z]+,\\s*[A-Z][A-Za-z ]+)\\b/, /\\b(?:Kuala Lumpur|Petaling Jaya|Penang|Johor|Shah Alam|Ipoh|Malacca|Kota Kinabalu|Kuching|Singapore|London|Paris|Berlin|Tokyo|Beijing|New York|California|Texas|Florida|Washington|Ukraine|Israel|Gaza|Taiwan|India|China|Japan|France|Germany|Spain|Italy|Australia|Canada)\\b/i]; function extractLocation(text) { if (!text) return ''; for (const pattern of locationPatterns) { const match = text.match(pattern); if (match) return (match[1] || match[0]).trim().replace(/^[,;:\\s]+|[,;:\\s]+$/g, ''); } return ''; } const out = []; for (let i = 0; i < items.length; i++) { const item = items[i].json; const combined = item.title || '' + ' ' + item.summary || ''; const location = extractLocation(combined); const next = { ...item }; if (location) { try { const qs = new URLSearchParams({ q: location, format: 'json', limit: '1' }).toString(); const res = await fetch('https://nominatim.openstreetmap.org/search?' + qs, { headers: { 'User-Agent': 'NearbypostGeoFix/1.0 (support@nearbypost.com)', 'Accept': 'application/json' } }); const data = await res.json(); if (Array.isArray(data) && data.length > 0 && data[0].lat && data[0].lon) { next.lat = Number.parseFloat(data[0].lat); next.lng = Number.parseFloat(data[0].lon); next.location_query = location; } } catch (error) { next.geocode_error = error.message; } await sleep(1000); } out.push({ json: next }); } return out;"
      },
      "id": "geocode-locations",
      "name": "Geocode Locations",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [900, 520]
    },
    {
      "parameters": {
        "functionCode": "const allItems = items.map(item => item.json); return [{ json: { items: allItems } }];"
      },
      "id": "batch-collect",
      "name": "Batch Collect",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [980, 520]
    },
    {
      "parameters": {
        "url": "http://172.18.0.1:8000/api/internal/ingest/batch",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "items", "value": "={{ $json.items }}" }] },
        "options": { "timeout": 60000 }
      },
      "id": "laravel-webhook",
      "name": "Ingest to Laravel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1200, 520]
    },
    {
      "parameters": {
        "functionCode": "const result = items[0]?.json; console.log('Batch ingestion result:', JSON.stringify(result, null, 2)); return items;"
      },
